#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

port=18080
base="http://127.0.0.1:$port"
image="$repo_root/capsule"
log="$(mktemp)"
state_file="$(mktemp)"
pid=""

cleanup() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$log" "$state_file" "$image"
}
trap cleanup EXIT

stop_service() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    pid=""
  fi
}

start_service() {
  : >"$log"
  mirage/dist/timecapsule-http --port "$port" >"$log" 2>&1 &
  pid=$!

  local ready=false
  for _ in $(seq 1 60); do
    if curl --silent --show-error "$base/state" >"$state_file" 2>/dev/null; then
      ready=true
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "MirageOS HTTP service exited before becoming ready" >&2
      cat "$log" >&2
      exit 1
    fi
    sleep 0.25
  done

  if [[ "$ready" != "true" ]]; then
    echo "MirageOS HTTP service did not become ready" >&2
    cat "$log" >&2
    exit 1
  fi
}

assert_json_equal() {
  python3 - "$1" "$2" <<'PY'
import json
import sys

actual = json.loads(sys.argv[1])
expected = json.loads(sys.argv[2])
assert actual == expected, (actual, expected)
PY
}

opam install .
opam install mirage.4.11.2 chamelon-unix

(
  cd mirage
  opam exec -- mirage configure -t unix --net socket
  opam exec -- make depends
  opam exec -- dune build
)

bash tools/create-capsule-image "$image"
start_service

initial="$(cat "$state_file")"
assert_json_equal "$initial" '{"state":"unsealed"}'

future=4102444800
waiting="$(
  curl --silent --show-error -X POST "$base/seal?deadline=$future"
)"
assert_json_equal "$waiting" "{"state":"waiting","deadline":$future}"

stop_service
start_service

waiting_after_reboot="$(cat "$state_file")"
assert_json_equal "$waiting_after_reboot" "{"state":"waiting","deadline":$future}"

too_early_file="$(mktemp)"
too_early_status="$(
  curl --silent --show-error -o "$too_early_file" -w '%{http_code}'     -X POST "$base/release"
)"
too_early="$(cat "$too_early_file")"
rm -f "$too_early_file"

if [[ "$too_early_status" != "409" ]]; then
  echo "release before future deadline unexpectedly succeeded: $too_early_status $too_early" >&2
  exit 1
fi

python3 - "$too_early" "$future" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
future = int(sys.argv[2])

assert payload["error"] == "too_early", payload
assert payload["deadline"] == future, payload
assert 0 < payload["observed_at"] < future, payload
PY

stop_service
bash tools/create-capsule-image "$image"
start_service

zero_waiting="$(
  curl --silent --show-error -X POST "$base/seal?deadline=0"
)"
assert_json_equal "$zero_waiting" '{"state":"waiting","deadline":0}'

released="$(
  curl --silent --show-error -X POST "$base/release"
)"

python3 - "$released" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
assert payload["state"] == "released", payload
assert payload["deadline"] == 0, payload
assert payload["released_at"] > 0, payload
PY

stop_service
start_service

released_after_reboot="$(cat "$state_file")"
assert_json_equal "$released_after_reboot" "$released"

released_again="$(
  curl --silent --show-error -X POST "$base/release"
)"
assert_json_equal "$released_again" "$released"

if curl --silent --show-error --fail -X POST "$base/release?now=0" >/dev/null 2>&1; then
  echo "release endpoint unexpectedly accepted a client-supplied now parameter" >&2
  exit 1
fi

stop_service
opam exec -- chamelon write "$image" 512 /capsule corrupt

: >"$log"
mirage/dist/timecapsule-http --port "$port" >"$log" 2>&1 &
pid=$!
sleep 1

if kill -0 "$pid" 2>/dev/null; then
  echo "service accepted a malformed persisted snapshot" >&2
  cat "$log" >&2
  exit 1
fi
wait "$pid" 2>/dev/null || true
pid=""

if ! grep -q "invalid persisted capsule snapshot" "$log"; then
  echo "service failed closed, but not for the expected snapshot validation reason" >&2
  cat "$log" >&2
  exit 1
fi

echo "MirageOS Unix durable TimeCapsule smoke test: OK"
